# ===== 基础 =====
PORT=3000
NODE_ENV=development

# JWT 签名密钥（生产务必改成随机长字符串）
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=30d

# ===== 数据存储 =====
# memory（默认，进程内，零依赖）| postgres | mysql | supabase
DB_DRIVER=memory

# --- 阿里云 RDS PostgreSQL（DB_DRIVER=postgres 时填写）---
# 本地开发用「外网地址」，node-server 部署在同 VPC 时改用「内网地址」
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=guangyu
PG_SSL=false

# --- 阿里云 RDS MySQL（DB_DRIVER=mysql 时填写）---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=guangyu

# --- Supabase（DB_DRIVER=supabase 时填写）---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ===== 用量与配额 =====
# 新用户注册赠送的免费次数
FREE_QUOTA=20

# ===== 微信登录（小程序）=====
# 缺省时走 mock（用 code 当 openid），方便本地联调
WECHAT_APPID=
WECHAT_SECRET=

# ===== 手机号登录（短信验证码）=====
# 缺省时走 mock（验证码直接在接口返回 + 打印日志），方便本地联调
# 生产接阿里云短信服务（见 src/utils/sms.js）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
